{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Run Flutter (Android)",
      "type": "shell",
      "command": "flutter",
      "args": ["run", "-d", "emulator-5554"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🧹 Clean Project",
      "type": "shell",
      "command": "flutter",
      "args": ["clean"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "📦 Get Dependencies",
      "type": "shell",
      "command": "flutter",
      "args": ["pub", "get"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🔍 Analyze Code",
      "type": "shell",
      "command": "flutter",
      "args": ["analyze"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "✨ Format Code",
      "type": "shell",
      "command": "dart",
      "args": ["format", "lib/"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🧪 Run Tests",
      "type": "shell",
      "command": "flutter",
      "args": ["test"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "📱 Build APK (Release)",
      "type": "shell",
      "command": "flutter",
      "args": ["build", "apk", "--release"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🌐 Build Web (Release)",
      "type": "shell",
      "command": "flutter",
      "args": ["build", "web", "--release"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "📊 Check Dependencies",
      "type": "shell",
      "command": "flutter",
      "args": ["pub", "outdated"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🔄 Clean & Get Dependencies",
      "dependsOn": ["🧹 Clean Project", "📦 Get Dependencies"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "✅ Full Check (Format + Analyze + Test)",
      "dependsOn": ["✨ Format Code", "🔍 Analyze Code", "🧪 Run Tests"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
